# The nginx image fills in ${SNIPPET_SERVICE_URL} from the environment when the container starts.
server {
    listen 80;
    root /usr/share/nginx/html;

    # The UI calls /api; snippet-service has no prefix.
    location /api/ {
        # Resolve snippet-service on each request through Docker's DNS, so nginx starts even if it is not up yet.
        resolver 127.0.0.11 valid=10s;
        set $snippet_service ${SNIPPET_SERVICE_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $snippet_service;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    # Single-page app: any other path is a route of the UI.
    location / {
        try_files $uri /index.html;
    }
}
